{
  "repository": "ramideltoro/nutsnews-android",
  "tagGlob": "android-v[0-9]*.[0-9]*.[0-9]*",
  "tagRegex": "^android-v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
  "packageName": "com.nutsnews.app",
  "track": "internal",
  "versionCode": {
    "strategy": "semver-base-1000",
    "minimumExclusive": 2,
    "maximumInclusive": 2100000000,
    "minorMaximum": 999,
    "patchMaximum": 999
  },
  "githubEnvironments": {
    "release-signing": {
      "deploymentPolicies": [
        {
          "type": "branch",
          "name": "main"
        },
        {
          "type": "tag",
          "name": "android-v*.*.*"
        }
      ]
    },
    "play-internal": {
      "deploymentPolicies": [
        {
          "type": "branch",
          "name": "main"
        },
        {
          "type": "tag",
          "name": "android-v*.*.*"
        }
      ]
    }
  }
}
